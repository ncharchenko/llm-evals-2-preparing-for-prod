# Provider key used by the LiteLLM proxy to call the upstream model provider.
OPENAI_API_KEY=<openai_api_key>

# LiteLLM proxy admin settings. The master key must start with "sk-".
LITELLM_MASTER_KEY=sk-local-litellm-master-key
LITELLM_SALT_KEY=<generate-a-secure-random-salt>

# Application-facing LiteLLM virtual key and proxy URL.
LITELLM_MODEL=gpt-4o-mini
LITELLM_EMBEDDINGS_MODEL=text-embedding-3-small
LITELLM_BASE_URL=http://0.0.0.0:4000
LITELLM_API_KEY=<litellm_virtual_key_or_master_key>
LITELLM_USER_ID=HyperUser

LANGFUSE_SECRET_KEY=<langfuse_secret_key>
LANGFUSE_PUBLIC_KEY=<langfuse_public_key>
LANGFUSE_HOST=<langfuse_host>

REDIS_URL=<redis_connection_url>
